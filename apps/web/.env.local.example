# Server-only — read by src/app/api/backend/[...path]/route.ts. Never prefix these with
# NEXT_PUBLIC_: that inlines the value into browser JS, which defeats the point of the proxy.
API_URL=http://localhost:8000
API_KEY=
HUMAN_APPROVAL_KEY=

# Real login (Google OAuth) — see src/app/api/auth/google/*, src/proxy.ts, src/lib/session.ts.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console; add
# http://localhost:3000/api/auth/google/callback (and your deployed origin's equivalent) as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of Google account emails permitted to sign in.
# Use * to allow any verified Google account.
ALLOWED_EMAILS=
# Random secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
