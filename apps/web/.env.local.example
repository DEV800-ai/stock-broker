# Server-only — read by src/app/api/backend/[...path]/route.ts. Never prefix these with
# NEXT_PUBLIC_: that inlines the value into browser JS, which defeats the point of the proxy.
API_URL=http://localhost:8000
API_KEY=
HUMAN_APPROVAL_KEY=

# Safe to expose to the browser — not secrets, just an operator label for audit logging.
NEXT_PUBLIC_ACTOR=operator
