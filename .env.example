DATABASE_URL=postgresql://postgres:password@localhost:5432/signalalpha

# Required. Shared secret for all API requests (header: X-API-Key).
# Generate with: openssl rand -hex 32
# This is a single-operator shared secret, not a multi-user auth system.
API_KEY=

# Optional. Second shared secret (header: X-Human-Key) required, in addition to
# API_KEY, for actions that must only ever be triggered by a human: order/paper-trade
# approval, agent kill switch unkill/autonomy-mode change (see auth.py::require_human_actor).
# Leave unset to keep today's single-key behavior. Set this once a caller other than
# the frontend (e.g. a future agent gateway) is issued its own API_KEY, so that caller
# still can't approve trades or loosen the kill switch.
# Generate with: openssl rand -hex 32
HUMAN_APPROVAL_KEY=

# IBKR Client Portal Gateway (must be running locally)
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Finnhub (free tier: https://finnhub.io)
FINNHUB_API_KEY=

# SEC EDGAR (free, no key). SEC requires a descriptive User-Agent identifying
# the requester on every request, format: "App Name contact@email". Unset
# skips EDGAR filing fetches.
SEC_EDGAR_USER_AGENT=

# Scanner thresholds
SCANNER_MIN_SCORE=0.30
THESIS_MIN_SCORE=0.50
SCANNER_UNIVERSE_SIZE=500

# Risk engine / paper trading
PAPER_ACCOUNT_EQUITY=100000
RISK_COOLDOWN_DAYS=14
ORDER_PREVIEW_TTL_MINUTES=5

# Paper fill simulation: adverse slippage, and partial/rejected fills when
# order size is large relative to 20-day average daily volume.
PAPER_FILL_SLIPPAGE_BPS=5.0
PAPER_FILL_PARTIAL_ADV_PCT=0.10
PAPER_FILL_REJECT_ADV_PCT=0.25
PAPER_FILL_MIN_PARTIAL_RATIO=0.3

# Phase 4 gate. Inert today — no code path reads this to enable live execution yet
# (execution/ibkr_adapter.py is a structural placeholder; see docs/HARDENING_PLAN.md).
ENABLE_LIVE_TRADING=false

# Staleness threshold for IBKRPortfolioProvider snapshots (broker/portfolio/ibkr_provider.py).
# Inert today — no live request path calls this provider yet.
IBKR_PORTFOLIO_MAX_STALENESS_SECONDS=300
