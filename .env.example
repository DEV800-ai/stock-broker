DATABASE_URL=postgresql://postgres:password@localhost:5432/signalalpha

# IBKR Client Portal Gateway (must be running locally)
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Finnhub (free tier: https://finnhub.io)
FINNHUB_API_KEY=

# Scanner thresholds
SCANNER_MIN_SCORE=0.30
THESIS_MIN_SCORE=0.50
SCANNER_UNIVERSE_SIZE=500

# Risk engine / paper trading
PAPER_ACCOUNT_EQUITY=100000
RISK_COOLDOWN_DAYS=14
